# Copy this file to .env and set a strong password before running `docker compose up`.
# .env is gitignored and is loaded automatically by `docker compose`.

POSTGRES_DB=thebirthdates
POSTGRES_USER=birthday
POSTGRES_PASSWORD=change_me_to_a_strong_password

# pgAdmin web UI login (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_to_a_strong_password
