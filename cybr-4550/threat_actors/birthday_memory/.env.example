# Postgres container credentials - read automatically by `docker compose` from a `.env`
# file in this same folder. These are the ACTUAL database credentials (separate from,
# and must match, server/.env's PGUSER/PGPASSWORD - the Node API's connection settings).
#
# Copy this file to .env (same folder, gitignored) and fill in real values:
#   copy .env.example .env          (Windows)
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"   (generate a password)
#
# Never commit the real .env.
POSTGRES_DB=thebirthdates
POSTGRES_USER=birthday_app
POSTGRES_PASSWORD=replace-with-a-long-random-generated-password
