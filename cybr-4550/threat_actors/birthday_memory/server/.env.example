# Port for the Express API
PORT=4000

# Option A: a single connection string (takes precedence over the PG* vars).
# DATABASE_URL=postgresql://user:password@host:5432/thebirthdates

# Option B: individual settings. These defaults match docker-compose.yml.
PGHOST=localhost
PGPORT=5544
PGUSER=birthday
PGPASSWORD=birthday
PGDATABASE=thebirthdates

# Set to "true" when connecting to a managed Postgres that requires SSL.
PGSSL=false

# --- Auth (added for Domain 1 / B2 remediation) ---
# JWT signing secret. MUST be a long random string (32+ chars) in your real .env.
# Generate one yourself, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Do NOT reuse this example value and do NOT commit your real .env.
JWT_SECRET=replace-this-with-a-long-random-generated-string-before-running

# Origin allowed to make credentialed API requests (CORS). Vite dev server default shown.
CLIENT_ORIGIN=http://localhost:5173

# Optional: used only by `npm run seed:user`. If unset, seed:user auto-generates
# a random username/password and prints it once. Prefer leaving these unset.
# ADMIN_USERNAME=team.lead
# ADMIN_PASSWORD=
